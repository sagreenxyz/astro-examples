---
import BaseLayout from '../layouts/BaseLayout.astro';

const examples = [
  {
    title: 'About Page',
    description: 'A polished about page with team info, mission statement, and contact details.',
    href: '/about',
    icon: '👥',
    tag: 'Page',
  },
  {
    title: 'Blog Listing',
    description: 'A responsive blog index with article cards, tags, and read-time estimates.',
    href: '/blog',
    icon: '📝',
    tag: 'Page',
  },
  {
    title: 'Component Showcase',
    description: 'Explore reusable UI components: buttons, cards, badges, alerts, and more.',
    href: '/components',
    icon: '🧩',
    tag: 'UI',
  },
];

const features = [
  { icon: '⚡', title: 'Zero JS by Default', body: 'Astro ships zero JavaScript by default, giving you blazing-fast page loads right out of the box.' },
  { icon: '🏝️', title: 'Islands Architecture', body: 'Hydrate only the interactive components you need, keeping the rest as pure static HTML.' },
  { icon: '🔌', title: 'Framework Agnostic', body: 'Use React, Svelte, Vue, Solid, or plain HTML — all in the same project without friction.' },
  { icon: '🗂️', title: 'File-Based Routing', body: 'Drop a file in `src/pages/` and it becomes a route. Simple, predictable, and powerful.' },
  { icon: '📦', title: 'Content Collections', body: 'Type-safe Markdown and MDX content management built right into the framework.' },
  { icon: '🌐', title: 'Deploy Anywhere', body: 'Static or server-rendered — deploy to Netlify, Vercel, Cloudflare Pages, or any static host.' },
];
---

<BaseLayout title="Astro Examples — Modern Web, Zero Bloat">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="container">
      <div class="badge">🚀 Built with Astro v6</div>
      <h1 class="hero-title">
        Build <span class="gradient-text">faster websites</span><br />
        with less complexity
      </h1>
      <p class="hero-body">
        Astro Examples is a curated showcase of pages, layouts, and components built with
        <strong>Astro.build</strong> — the web framework for content-driven sites.
        Browse real examples, copy patterns, and ship with confidence.
      </p>
      <div class="hero-actions">
        <a href="/components" class="btn btn-primary">Browse Components</a>
        <a href="/blog" class="btn btn-ghost">Read the Blog</a>
      </div>
      <div class="hero-stats">
        <div class="stat"><span class="stat-value">3</span><span class="stat-label">Example Pages</span></div>
        <div class="stat-divider"></div>
        <div class="stat"><span class="stat-value">10+</span><span class="stat-label">UI Components</span></div>
        <div class="stat-divider"></div>
        <div class="stat"><span class="stat-value">100</span><span class="stat-label">Lighthouse Score</span></div>
      </div>
    </div>
  </section>

  <!-- Examples Grid -->
  <section class="section" id="examples">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Explore Examples</h2>
        <p class="section-body">Handcrafted pages demonstrating real-world Astro patterns. Click any card to see the full page.</p>
      </div>
      <div class="examples-grid">
        {examples.map((ex) => (
          <a href={ex.href} class="example-card">
            <div class="card-icon">{ex.icon}</div>
            <div class="card-tag">{ex.tag}</div>
            <h3 class="card-title">{ex.title}</h3>
            <p class="card-body">{ex.description}</p>
            <span class="card-link">View example →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section section-alt" id="features">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Why Astro?</h2>
        <p class="section-body">Everything you love about modern web development, without the baggage.</p>
      </div>
      <div class="features-grid">
        {features.map((f) => (
          <div class="feature-card">
            <div class="feature-icon">{f.icon}</div>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-body">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-inner">
        <h2 class="cta-title">Ready to build something fast?</h2>
        <p class="cta-body">Start your Astro project in seconds and deploy it for free on any platform.</p>
        <div class="cta-actions">
          <a href="https://astro.build/docs" target="_blank" rel="noopener" class="btn btn-primary">Read the Docs</a>
          <a href="https://github.com/withastro/astro" target="_blank" rel="noopener" class="btn btn-ghost">Star on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 7rem 1.5rem 6rem;
    text-align: center;
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 50% 0%, rgba(124,58,237,0.22) 0%, transparent 70%);
    pointer-events: none;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(124,58,237,0.15);
    border: 1px solid rgba(124,58,237,0.35);
    color: var(--color-primary-light);
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-white);
    margin-bottom: 1.5rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, #a78bfa 0%, #06b6d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-body {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto 2.5rem;
    line-height: 1.75;
  }

  .hero-body strong {
    color: var(--color-text);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 4rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.75rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #fff;
    box-shadow: 0 0 24px rgba(124,58,237,0.4);
  }

  .btn-primary:hover {
    background: #6d28d9;
    box-shadow: 0 0 32px rgba(124,58,237,0.6);
    transform: translateY(-1px);
  }

  .btn-ghost {
    background: var(--color-surface-2);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-ghost:hover {
    background: var(--color-surface);
    border-color: var(--color-primary-light);
    color: var(--color-primary-light);
    transform: translateY(-1px);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.03em;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border);
  }

  /* ── Sections ── */
  .section {
    padding: 5rem 1.5rem;
  }

  .section-alt {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .section-body {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 520px;
    margin: 0 auto;
  }

  /* ── Examples Grid ── */
  .examples-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .example-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    position: relative;
  }

  .example-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-3px);
    box-shadow: 0 8px 32px rgba(124,58,237,0.2);
  }

  .card-icon {
    font-size: 2rem;
  }

  .card-tag {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(124,58,237,0.15);
    border: 1px solid rgba(124,58,237,0.3);
    color: var(--color-primary-light);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-white);
  }

  .card-body {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    flex: 1;
  }

  .card-link {
    color: var(--color-primary-light);
    font-size: 0.875rem;
    font-weight: 600;
    margin-top: 0.5rem;
    transition: opacity 0.2s;
  }

  .example-card:hover .card-link {
    opacity: 0.8;
  }

  /* ── Features Grid ── */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .feature-card {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: border-color 0.2s;
  }

  .feature-card:hover {
    border-color: rgba(124,58,237,0.5);
  }

  .feature-icon {
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
  }

  .feature-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-white);
  }

  .feature-body {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  /* ── CTA ── */
  .cta-section {
    padding: 5rem 1.5rem;
  }

  .cta-inner {
    background: linear-gradient(135deg, rgba(124,58,237,0.2) 0%, rgba(6,182,212,0.1) 100%);
    border: 1px solid rgba(124,58,237,0.3);
    border-radius: var(--radius-lg);
    padding: 4rem 2rem;
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .cta-title {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .cta-body {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    max-width: 420px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
</style>
